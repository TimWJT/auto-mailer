{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Mailer",
  "version": "0.1.0",
  "identifier": "com.automailer.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Auto Mailer",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Personalised email campaigns with automatic follow-ups",
    "longDescription": "Sends personalised plain-text emails from your own Gmail or Microsoft account, follows up automatically, and stops as soon as someone replies. Everything stays on your computer.",
    "category": "Productivity",
    "copyright": "© 2026 Tim Wang",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Auto Mailer"
      }
    },
    "publisher": "Tim Wang",
    "homepage": "https://github.com/TimWJT/auto-mailer"
  }
}
